{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/l/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|slackbot|whatsapp|telegrambot|linkedinbot|discordbot|pinterest|skypeuripreview|applebot|mastodon|bingbot|googlebot).*"
        }
      ],
      "destination": "/api/og-list?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
